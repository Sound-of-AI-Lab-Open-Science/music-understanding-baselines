+#: How many POP909 songs the chord/root corpora index. The original code ended
+#: ``_build_index`` in a hardcoded ``[:30]``; that stays the default so existing
+#: results remain reproducible, but it is now overridable per dataset
+#: (``kwargs: {max_songs: all}``) or globally
+#: (``BENCHMIR_POP909_MAX_SONGS=all``). ``all``/``0``/``-1``/``none`` mean "no
+#: limit" (all 909 songs). Key estimation never had the slice and is unaffected.
+DEFAULT_POP909_MAX_SONGS = 30
+
+
+def resolve_max_songs(max_songs: int | str | None = None) -> int | None:
+    """Explicit kwarg wins, then $BENCHMIR_POP909_MAX_SONGS, then the default."""
+    value: int | str | None = max_songs
+    if value is None:
+        value = os.environ.get("BENCHMIR_POP909_MAX_SONGS")
+    if value is None:
+        return DEFAULT_POP909_MAX_SONGS
+    if isinstance(value, str):
+        if value.strip().lower() in {"all", "none", ""}:
+            return None
+        value = int(value)
+    return None if value <= 0 else value
+
